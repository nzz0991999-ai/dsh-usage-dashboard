{
  "name": "deepseek-harness-usage-dashboard",
  "version": "1.0.1",
  "description": "DeepSeek Harness plugin for viewing official DeepSeek balance, usage, and billed spend in the Web UI.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "usage-dashboard",
    "billing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nzz0991999-ai/dsh-usage-dashboard.git"
  },
  "homepage": "https://github.com/nzz0991999-ai/dsh-usage-dashboard#readme",
  "bugs": {
    "url": "https://github.com/nzz0991999-ai/dsh-usage-dashboard/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "SECURITY.md",
    "SECURITY_EN.md",
    "CHANGELOG.md",
    "CHANGELOG_EN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --input-type=module -e \"await import('./src/index.js'); console.log('host import ok')\"",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    }
  }
}
